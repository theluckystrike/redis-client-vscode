{
  "name": "zovo-redis-client",
  "displayName": "Redis Client & Redis GUI: Keys, TTL, Streams, Cluster & Sentinel (Redis Viewer)",
  "description": "Free Redis client and Redis GUI for VS Code: browse keys with SCAN, edit strings, hashes, lists, sets, sorted sets, streams and RedisJSON, set TTL. Cluster, Sentinel, TLS and ACL users; works with Valkey and KeyDB. Console, server info, pub/sub, JSON export. No sign-in, no telemetry. Not affiliated with Redis Ltd.",
  "version": "0.1.0",
  "publisher": "zovo",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1B1F2B",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=18"
  },
  "categories": [
    "Other",
    "Data Science",
    "Programming Languages"
  ],
  "keywords": [
    "redis",
    "redis client",
    "redis gui",
    "redis viewer",
    "redis explorer",
    "valkey",
    "keydb",
    "redis cluster",
    "redis sentinel",
    "redis streams",
    "ttl",
    "cache",
    "database client",
    "key value",
    "nosql",
    "pubsub",
    "redisjson",
    "free"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:redisClient.explorer"
  ],
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Connections are stored per user, not per workspace. Nothing runs from the workspace."
    },
    "virtualWorkspaces": true
  },
