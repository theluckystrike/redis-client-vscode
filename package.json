    "configuration": {
      "title": "Redis Client",
      "properties": {
        "redisClient.scanPageSize": {
          "type": "number",
          "default": 10000,
          "minimum": 100,
          "description": "Keys loaded into the tree per page. SCAN runs in steps of redisClient.scanCount, so a big database never blocks the server or the editor. Load more keys from the end of the list."
        },
        "redisClient.scanCount": {
          "type": "number",
          "default": 1000,
          "minimum": 10,
          "maximum": 100000,
          "description": "The COUNT hint of each SCAN call."
        },
        "redisClient.pageSize": {
          "type": "number",
          "default": 200,
          "minimum": 10,
          "maximum": 10000,
          "description": "Rows read per page in the hash, list, set, sorted set and stream editors."
        },
        "redisClient.maxValueSizeMB": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 512,
          "description": "String values larger than this open as a size message (with Show the first 64 KB and Save to a file) instead of loading into the editor."
        },
        "redisClient.exportMaxValueMB": {
          "type": "number",
          "default": 64,
          "minimum": 1,
          "maximum": 1024,
          "description": "Export skips string values larger than this and lists them at the end."
        },
        "redisClient.connectTimeoutSeconds": {
          "type": "number",
          "default": 10,
          "minimum": 2,
          "maximum": 120,
          "description": "Give up connecting after this many seconds, with a message that names the step that failed (DNS, TCP, TLS, AUTH)."
        },
        "redisClient.commandTimeoutSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "maximum": 3600,
          "description": "Give up on a command that gets no answer after this many seconds."
        },
        "redisClient.historySize": {
          "type": "number",
          "default": 200,
          "minimum": 10,
          "maximum": 5000,
          "description": "Console commands kept per connection on this computer (VS Code global storage). Nothing is sent anywhere."
        },
        "redisClient.askForRating": {
          "type": "boolean",
          "default": true,
          "description": "Ask for a Marketplace rating after 2 good sessions at least 4 hours apart. \"Later\" asks once more after 7 days, \"No thanks\" never asks again. Never after an error. Nothing is sent anywhere."
        },
        "redisClient.showSupportLinks": {
          "type": "boolean",
          "default": true,
          "description": "Show the small Rate, More free tools, Sponsor and PayPal links at the bottom of the key editor and the other panels. Nothing is sent anywhere."
        },
        "redisClient.showProFeatures": {
          "type": "boolean",
          "default": true,
          "description": "Show the Zovo Pro tools (Memory Analysis, Bulk TTL / Delete by Pattern) and the Zovo Pro commands in menus and the command palette. Set it to false to hide them. Everything free keeps working."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "redisClient.start",
        "title": "Get started with the Redis client",
        "description": "Connect to Redis, Valkey or KeyDB, browse keys and edit values. Free, no sign-in.",
        "steps": [
          {
            "id": "connect",
            "title": "Add a connection",
            "description": "Paste a URL such as redis://default:secret@localhost:6379/0, or pick Cluster or Sentinel and list the nodes. TLS with your own CA file works too. The password goes to VS Code's secret storage.\n[Add Connection](command:redisClient.addConnection)",
            "media": {
              "markdown": "walkthrough/connect.md"
            },
            "completionEvents": [
              "onCommand:redisClient.addConnection"
            ]
          },
          {
            "id": "browse",
            "title": "Browse and edit keys",
            "description": "Expand a database: keys load with SCAN in pages and group into folders by \":\". Click a key to open its editor: strings (text, JSON, hex), hashes, lists, sets, sorted sets, streams with consumer groups, RedisJSON. Set or remove the TTL in the header.",
            "media": {
              "markdown": "walkthrough/browse.md"
            }
          },
          {
            "id": "tools",
            "title": "Console, server info and pub/sub",
            "description": "Right-click a connection for the console (history, Tab completion, a question before FLUSHALL and the like), server info with the slow log and clients, and pub/sub. Turn on read-only for a production server.\n[Open Console](command:redisClient.openConsole)",
            "media": {
              "markdown": "walkthrough/tools.md"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.js --production",
    "test": "node scripts/build.js --production && ZOVO_SPONSORS_MODULE=$PWD/src/license/sponsors.js node --test \"test/*.test.js\"",
    "test:it": "ZOVO_REDIS_IT=1 node --test --test-concurrency=1 test/integration.test.js",
    "package": "npm run build && npx -y @vscode/vsce package --no-dependencies -o dist/"
  },
  "devDependencies": {
    "@types/vscode": "~1.90.0",
    "esbuild": "0.28.2",
